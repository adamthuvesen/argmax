#!/bin/sh
# Refuses a commit with a secret in the staged files. .gitleaks.toml lists the
# test fixtures that look like secrets.
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-commit: gitleaks is not installed, so staged files were not scanned for secrets. Run: brew install gitleaks" >&2
  exit 0
fi
exec gitleaks git --staged --no-banner --redact --log-level warn
