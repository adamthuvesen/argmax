{
  "name": "argmax",
  "version": "0.6.0",
  "private": true,
  "description": "Local desktop command center for Claude Code and Codex sessions.",
  "author": "Adam Thuvesen <a.thuvesen@gmail.com>",
  "type": "module",
  "scripts": {
    "tauri:dev": "tauri dev",
    "tauri:dev:isolated": "ARGMAX_DATA_DIR=\"${ARGMAX_DATA_DIR:-$HOME/.argmax-dev}\" tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:universal": "tauri build --target universal-apple-darwin",
    "build:renderer": "node scripts/build-visualization-runtime.mjs --check && vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "export:provider-models": "node scripts/export-provider-models.mjs",
    "export:ios-tool-icons": "node scripts/export-ios-tool-icons.mjs",
    "export:ios-agent-emblems": "node scripts/export-ios-agent-emblems.mjs",
    "build:ios-fonts": "uv run scripts/build-ios-fonts.py",
    "install:ios": "node scripts/install-ios.mjs",
    "lint": "node scripts/lint.mjs",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "npm run test:unit && npm run test:perf && npm run test:rust",
    "test:unit": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts --no-file-parallelism",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --workspace",
    "test:ios": "node scripts/ios-tests.mjs",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --workspace --all-targets -- -D warnings",
    "push-gate": "node scripts/precheck.mjs",
    "verify": "node .agents/skills/verify-argmax/verify",
    "verify:native": "node scripts/verify.mjs",
    "bench:latency": "node scripts/bench-latency.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "generate:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features helper-bins --bin export-bindings -- src/shared/bindings.d.ts",
    "check:main-thread": "node scripts/check-main-thread-handlers.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:ios-fonts": "node scripts/check-ios-fonts.mjs",
    "check:provider-models": "node scripts/export-provider-models.mjs --check",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "generate:contracts": "node scripts/build-visualization-runtime.mjs && npm run generate:bindings && node scripts/export-remote-contracts.mjs && node scripts/export-swift-contracts.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:rust-boundaries": "node scripts/check-rust-boundaries.mjs",
    "check": "node scripts/check.mjs",
    "check:static": "node scripts/static-checks.mjs",
    "check:changed": "node scripts/check-changed.mjs",
    "build:appearance-bootstrap": "node scripts/build-appearance-bootstrap.mjs",
    "fix": "node scripts/lint.mjs --fix && oxfmt",
    "slow": "npm run test:perf && npm run test:rust"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/ibm-plex-sans": "^5.3.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@react-symbols/icons": "^1.4.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.18.4",
    "lucide": "1.47.0",
    "lucide-react": "^1.47.0",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1",
    "shiki": "^4.0.2",
    "simple-icons": "^16.29.0",
    "turndown": "^7.2.4",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/tauri-service": "^1.3.0",
    "dependency-cruiser": "^18.7.2",
    "hast-util-to-html": "^9.0.5",
    "jsdom": "^25.0.1",
    "knip": "^6.44.1",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "typescript": "7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "unified": "^11.0.5",
    "vite": "^8",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "katex": "$katex"
  }
}
