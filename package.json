{
  "name": "argmax",
  "version": "0.5.1",
  "private": true,
  "description": "Local desktop command center for Claude Code and Codex sessions.",
  "author": "Adam Thuvesen <a.thuvesen@gmail.com>",
  "type": "module",
  "scripts": {
    "tauri:dev": "tauri dev",
    "tauri:dev:isolated": "ARGMAX_DATA_DIR=\"${ARGMAX_DATA_DIR:-$HOME/.argmax-dev}\" tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:universal": "tauri build --target universal-apple-darwin",
    "build:renderer": "vite build",
    "build:icons": "node scripts/build-icons.mjs",
    "export:provider-models": "node scripts/export-provider-models.mjs",
    "export:ios-tool-icons": "node scripts/export-ios-tool-icons.mjs",
    "export:ios-agent-emblems": "node scripts/export-ios-agent-emblems.mjs",
    "build:ios-fonts": "uv run scripts/build-ios-fonts.py",
    "install:ios": "node scripts/install-ios.mjs",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:perf && npm run test:rust",
    "test:unit": "vitest run",
    "test:perf": "vitest run --config vitest.perf.config.ts --no-file-parallelism",
    "test:watch": "vitest",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "precheck": "node scripts/precheck.mjs",
    "verify": "node scripts/verify.mjs",
    "doctor": "node scripts/doctor.mjs",
    "prepare": "git config core.hooksPath .githooks",
    "coverage": "vitest run --coverage",
    "tauri": "tauri",
    "generate:bindings": "cargo run --manifest-path src-tauri/Cargo.toml --features helper-bins --bin export-bindings -- src/shared/bindings.d.ts",
    "check:tauri-bridge": "node scripts/check-tauri-bridge.mjs",
    "check:main-thread": "node scripts/check-main-thread-handlers.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:ios-fonts": "node scripts/check-ios-fonts.mjs",
    "typecheck": "node node_modules/typescript-7/bin/tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.3",
    "@codemirror/legacy-modes": "^6.5.2",
    "@codemirror/search": "^6.7.0",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.42.1",
    "@floating-ui/react-dom": "^2.1.9",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@leeoniya/ufuzzy": "^1.0.19",
    "@react-symbols/icons": "^1.4.1",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "katex": "^0.18.4",
    "lucide-react": "^0.468.0",
    "marked": "^16.4.2",
    "mermaid": "^12.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remend": "^1.3.1",
    "shiki": "^4.0.2",
    "simple-icons": "^16.29.0",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.1.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.0.2",
    "@types/turndown": "^5.0.6",
    "@vitejs/plugin-react": "^6",
    "@vitest/coverage-v8": "^5.0.1",
    "@wdio/tauri-service": "^1.3.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.61.1",
    "vite": "^8",
    "vitest": "^5.0.1"
  }
}
